# ─────────────────────────────────────────────
# DendroVox - Ortam Değişkenleri Şablonu
# ─────────────────────────────────────────────
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun:
#   copy .env.example .env
# ─────────────────────────────────────────────

# Flask
# Uzun ve rastgele olmalı. Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-guclu-bir-anahtar-yazin
# Geliştirme sırasında 1, gerçek kullanımda mutlaka 0
FLASK_DEBUG=0

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# İsteğe bağlı: model zinciri (virgülle). Biri kotaya takılınca sıradaki denenir.
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite,gemini-flash-latest
# GEMINI_TTS_MODELS=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
# GİZLİ anahtar: Supabase > Project Settings > API > service_role
# (anon/publishable anahtar artık yetmez; RLS herkese açık erişimi kapatır)
SUPABASE_SERVICE_KEY=

# Yönetim paneli (/admin) şifresi. Boş bırakılırsa panel kapalı olur.
ADMIN_PASSWORD=

# İsteğe bağlı ayarlar
# CHAT_LIMIT=12                      # bir sohbette gönderilebilecek mesaj sayısı
# CHAT_RATE_LIMIT=15/minute;200/day  # tarayıcı başına
# CHAT_IP_RATE_LIMIT=60/minute;1500/day
# WEATHER_ENABLED=1                  # karakterler anlık havayı bilsin (Open-Meteo, anahtarsız)
# TIMEZONE=Europe/Istanbul
